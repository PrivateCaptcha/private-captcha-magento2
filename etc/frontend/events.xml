<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="controller_action_predispatch">
        <observer name="private_captcha_validate_predispatch"
                  instance="PrivateCaptcha\PrivateCaptcha\Observer\ValidatePredispatch"/>
    </event>
    <event name="controller_action_postdispatch">
        <observer name="private_captcha_sanitize_persisted_state"
                  instance="PrivateCaptcha\PrivateCaptcha\Observer\SanitizePersistedState"/>
    </event>
</config>
